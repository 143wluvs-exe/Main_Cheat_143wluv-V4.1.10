end))
trackConnection(transparencyButton.Activated:Connect(function()
    transparency = (transparency + 0.1) % 0.6
    box.BackgroundTransparency = transparency
    transparencyButton.Text = "TRANSPARENCY: " .. math.floor(transparency * 100) .. "%"
end))
trackConnection(resetSettings.Activated:Connect(function()
    FOV = 4
    Smoothness = 1
    transparency = 0
    box.BackgroundTransparency = 0
    fovLabel.Text = "AIM FOV: " .. FOV .. "°"
    smoothLabel.Text = "AIM SMOOTHNESS: " .. string.format("%.1f", Smoothness)
    transparencyButton.Text = "TRANSPARENCY: 0%"
end))

--------------------------------------------------
-- VERSION / RESTORE BUTTON
--------------------------------------------------
local version = makeText(box, "Version", "V6.0.0",
    UDim2.new(0, 145, 0, 20), UDim2.new(0, 10, 1, -27), 12)
version.TextColor3 = Color3.fromRGB(160, 160, 170)

restoreBtn = makeButton(gui, "RestoreButton", "143WLUV$",
    UDim2.fromOffset(110, 38), UDim2.new(0, 15, 0, 15))
restoreBtn.Visible = false
restoreBtn.Active = true
restoreBtn.Selectable = true
restoreBtn.Draggable = true
restoreBtn.ZIndex = 100
restoreBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
restoreBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
restoreBtn.AutoButtonColor = true

-- Keep the restore pill above the panel and other UI without a UIStroke outline.

local function minimizeMainPanel()
    if menuClosed or not box or not box.Parent or not restoreBtn or not restoreBtn.Parent then
        return
    end
    local compactSize = UDim2.fromOffset(520, 360)
    tweenObject(box, TWEEN_MED, {Size = compactSize})
    task.delay(0.22, function()
        if menuClosed or not box or not box.Parent then return end
        box.Visible = false
        -- Preserve the user's selected panel transparency while minimized.
        box.BackgroundTransparency = transparency
        box.Size = UDim2.fromOffset(580, 410)
    end)
    restoreBtn.Visible = true
    restoreBtn.Active = true
    restoreBtn.BackgroundTransparency = 1
    tweenObject(restoreBtn, TWEEN_SPRING, {BackgroundTransparency = 0})
end

local function restoreMainPanel()
    if menuClosed or not box or not box.Parent or not restoreBtn or not restoreBtn.Parent then
        return
    end
    restoreBtn.Visible = false
    box.Size = UDim2.fromOffset(540, 380)
    box.Position = UDim2.new(0.5, -270, 0.5, -190)
    -- Restore the panel using the transparency selected in Settings.
    box.BackgroundTransparency = transparency
    box.Visible = true
    box.ZIndex = 1
    tweenObject(box, TWEEN_SPRING, {
        Size = UDim2.fromOffset(580, 410),
        Position = UDim2.new(0.5, -290, 0.5, -205)
    })
end

trackConnection(minimizeBtn.Activated:Connect(minimizeMainPanel))
trackConnection(restoreBtn.Activated:Connect(restoreMainPanel))
-- MouseButton1Click fallback helps ensure the restore pill works on desktop touch/mouse input.
trackConnection(restoreBtn.MouseButton1Click:Connect(restoreMainPanel))

--------------------------------------------------
-- KEY VERIFICATION + 5 SECOND LOADING
--------------------------------------------------
box.Visible = false
restoreBtn.Visible = false

local keyFrame = Instance.new("Frame")
