antiFlingAnchorPart.Parent = workspace

local function antiFlingGetCharacter()
    local character = antiFlingPlayer.Character
    if not character then return nil end
    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if root and humanoid then
        return character, root, humanoid
    end
    return nil
end

local function antiFlingUpdateAnchor()
    if not antiFlingRunning then return end
    local _, root = antiFlingGetCharacter()
    if root then
        antiFlingAnchorPart.CFrame = root.CFrame + Vector3.new(0, 2, 0)
    end
end

local antiFlingOriginalProperties = {}
local antiFlingOriginalStates = {}

local function antiFlingSaveCharacter(character)
    antiFlingOriginalProperties = {}
    antiFlingOriginalStates = {}
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            antiFlingOriginalProperties[obj] = obj.CustomPhysicalProperties
        end
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        antiFlingOriginalStates[Enum.HumanoidStateType.Ragdoll] =
            humanoid:GetStateEnabled(Enum.HumanoidStateType.Ragdoll)
        antiFlingOriginalStates[Enum.HumanoidStateType.FallingDown] =
            humanoid:GetStateEnabled(Enum.HumanoidStateType.FallingDown)
    end
end

local function antiFlingRestoreCharacter()
    for part, properties in pairs(antiFlingOriginalProperties) do
        if part and part.Parent then
            part.CustomPhysicalProperties = properties
        end
    end
    local _, _, humanoid = antiFlingGetCharacter()
    if humanoid then
        for state, enabled in pairs(antiFlingOriginalStates) do
            humanoid:SetStateEnabled(state, enabled)
        end
    end
    antiFlingOriginalProperties = {}
    antiFlingOriginalStates = {}
end

local function antiFlingStart()
    if antiFlingRunning then return end
    antiFlingRunning = true
    local character = antiFlingPlayer.Character
    if character then
        antiFlingSaveCharacter(character)
    end

    antiFlingUpdateConnection = AntiFlingRunService.Heartbeat:Connect(function()
        if not antiFlingRunning then return end
        local char, root, humanoid = antiFlingGetCharacter()
        if not char or not root or not humanoid then return end

        if root.AssemblyLinearVelocity.Magnitude > 100 then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.AssemblyAngularVelocity = Vector3.zero
                    obj.AssemblyLinearVelocity = Vector3.zero
                end
            end
            root.AssemblyAngularVelocity = Vector3.zero
            root.AssemblyLinearVelocity = Vector3.zero
            antiFlingUpdateAnchor()
        end
    end)
    antiFlingPlayNotification("Anti Fling is ON")
end

local function antiFlingStop()
    if not antiFlingRunning then return end
    antiFlingRunning = false
    if antiFlingUpdateConnection then
        antiFlingUpdateConnection:Disconnect()
        antiFlingUpdateConnection = nil
    end
    antiFlingRestoreCharacter()
    antiFlingPlayNotification("Anti Fling is OFF")
end

local function antiFlingRefreshToggle()
    if antiFlingRunning then
        antiFlingToggle.Text = "ANTI FLING (143wluv$)"
        antiFlingToggle.BackgroundColor3 = Color3.fromRGB(25, 130, 65)
        antiFlingStatus.Text = "Status: Enabled"
        antiFlingStatus.TextColor3 = Color3.fromRGB(100, 255, 140)
    else
        antiFlingToggle.Text = "ANTI FLING (143wluv$)"
        antiFlingToggle.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
        antiFlingStatus.Text = "Status: Disabled"
        antiFlingStatus.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end

antiFlingToggle.Activated:Connect(function()
    if antiFlingRunning then
        antiFlingStop()
    else
        antiFlingStart()
    end
    antiFlingRefreshToggle()
end)

antiFlingCharacterConnection = antiFlingPlayer.CharacterAdded:Connect(function(character)
    task.wait(1)
    if antiFlingRunning then
        antiFlingSaveCharacter(character)
    end
end)

antiFlingAnchorConnection = AntiFlingRunService.Heartbeat:Connect(function()
    if antiFlingRunning then
        antiFlingUpdateAnchor()
    end
end)

antiFlingGui.Destroying:Connect(function()
    antiFlingStop()
    if antiFlingCharacterConnection then
        antiFlingCharacterConnection:Disconnect()
    end
    if antiFlingAnchorConnection then
        antiFlingAnchorConnection:Disconnect()
    end
    antiFlingAnchorPart:Destroy()
    antiFlingSound:Destroy()
end)

