local function trackConnection(connection)
    table.insert(connections, connection)
    return connection
end

local TWEEN_FAST = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_MED = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TWEEN_SPRING = TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local function tweenObject(object, info, properties)
    if not object or not object.Parent then return nil end
    local tween = TweenService:Create(object, info, properties)
    tween:Play()
    return tween
end

local function animatePanelOpen(panel, finalSize, finalPosition)
    if not panel or not panel.Parent then return end
    panel.Visible = true
    panel.BackgroundTransparency = 1
    panel.Size = UDim2.new(finalSize.X.Scale, finalSize.X.Offset * 0.94,
        finalSize.Y.Scale, finalSize.Y.Offset * 0.90)
    panel.Position = finalPosition + UDim2.fromOffset(0, 8)
    tweenObject(panel, TWEEN_SPRING, {
        Size = finalSize, Position = finalPosition, BackgroundTransparency = 0
    })
end

local function makeCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
    return corner
end

local function makeStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(65, 65, 72)
    stroke.Thickness = thickness or 1
    stroke.Parent = parent
    return stroke
end

local function makeText(parent, name, text, size, position, textSize, font)
    local label = Instance.new("TextLabel")
    label.Name = name
    label.Size = size
    label.Position = position
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = textSize or 14
    label.Font = font or Enum.Font.Gotham
    label.Parent = parent
    return label
end

local function makeButton(parent, name, text, size, position)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = size
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.AutoButtonColor = true
    button.Parent = parent
    makeCorner(button, 7)
    local normalColor = button.BackgroundColor3
    button.MouseEnter:Connect(function()
        if button and button.Parent then
            tweenObject(button, TWEEN_FAST, {BackgroundColor3 = normalColor:Lerp(Color3.fromRGB(95, 105, 120), 0.32)})
        end
    end)
    button.MouseLeave:Connect(function()
        if button and button.Parent then
            tweenObject(button, TWEEN_FAST, {BackgroundColor3 = normalColor})
        end
    end)
    button.Activated:Connect(function()
        if button and button.Parent then
            local original = button.Size
            tweenObject(button, TWEEN_FAST, {Size = UDim2.new(original.X.Scale, original.X.Offset - 2, original.Y.Scale, original.Y.Offset - 1)})
            task.delay(0.08, function()
                if button and button.Parent then tweenObject(button, TWEEN_FAST, {Size = original}) end
            end)
        end
    end)
    return button
end

local function setStatus(text, enabled)
    if status and status.Parent then
        status.Text = "STATUS  /  " .. text
        status.TextColor3 = enabled
            and Color3.fromRGB(100, 255, 145)
            or Color3.fromRGB(230, 125, 125)
    end
end

--------------------------------------------------
-- BIGHEAD (LOCAL VISUAL ONLY)
--------------------------------------------------
local HEAD_SIZE = 4
local HEAD_TRANSPARENCY = 0.7
local originalHeadProperties = {}

local function applyBigHead(character)
    if not BigheadEnabled or not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    if not humanoid or not head or not head:IsA("BasePart") then return end

    if not originalHeadProperties[head] then
        originalHeadProperties[head] = {
            Size = head.Size,
            Transparency = head.Transparency,
            CanCollide = head.CanCollide,
        }
    end

    local original = originalHeadProperties[head]
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        head.Size = Vector3.new(HEAD_SIZE, HEAD_SIZE, HEAD_SIZE)
    else
        head.Size = original.Size * HEAD_SIZE
    end
    head.Transparency = HEAD_TRANSPARENCY
    head.CanCollide = false
end

local function restoreBigHeads()
    BigheadEnabled = false
    for head, original in pairs(originalHeadProperties) do
        if head and head.Parent then
            head.Size = original.Size
            head.Transparency = original.Transparency
            head.CanCollide = original.CanCollide
        end
    end
    table.clear(originalHeadProperties)
end

local function applyBigHeadToAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            applyBigHead(player.Character)
        end
    end
end

local function watchPlayer(player)
    trackConnection(player.CharacterAdded:Connect(function(character)
        task.wait(0.25)
        if menuClosed then return end
        if BigheadEnabled then applyBigHead(character) end
        if EspEnabled then
            task.wait(0.1)
            -- ESP is applied by the ESP section below.
        end
    end))
end

for _, player in ipairs(Players:GetPlayers()) do
    watchPlayer(player)
end
trackConnection(Players.PlayerAdded:Connect(watchPlayer))

--------------------------------------------------
-- TARGET AIM (TEST IN YOUR OWN EXPERIENCE)
--------------------------------------------------
local function getTargetPosition(character)
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")
    if head then return head.Position end
    if root then return root.Position end
    return nil
end

local function getClosestPlayer()
    local camera = workspace.CurrentCamera
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
    if not camera or not myRoot then return nil end

    local closestTarget
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")
            local target = getTargetPosition(character)

            if humanoid and humanoid.Health > 0 and root and target then
                local _, onScreen = camera:WorldToScreenPoint(target)
                if onScreen then
                    local offset = target - camera.CFrame.Position
                    if offset.Magnitude > 0 then
                        local angle = math.deg(math.acos(math.clamp(
                            camera.CFrame.LookVector:Dot(offset.Unit), -1, 1
                        )))
                        local distance = (myRoot.Position - target).Magnitude
                        if angle <= FOV and distance < shortestDistance then
                            shortestDistance = distance
                            closestTarget = target
                        end
                    end
                end
            end
        end
    end
    return closestTarget
end

local function aimAtTarget()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local target = getClosestPlayer()
    if target then
        local targetCFrame = CFrame.new(camera.CFrame.Position, target)
        camera.CFrame = camera.CFrame:Lerp(targetCFrame, math.clamp(Smoothness, 0.05, 1))
    end
end

--------------------------------------------------
-- RAINBOW ESP
--------------------------------------------------
local ESP_ENABLED = false
local RAINBOW_SPEED = 0.5
local MAX_DISTANCE = 1000
local HIGHLIGHT_NAME = "YelimRainbowESP"
local BILLBOARD_NAME = "YelimUsernameESP"
local espTracked = {}

local function rainbowColor()
    return Color3.fromHSV((os.clock() * RAINBOW_SPEED) % 1, 1, 1)
end

local function removeESP(character)
    if not character then return end
    local data = espTracked[character]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        espTracked[character] = nil
    end
    local oldHighlight = character:FindFirstChild(HIGHLIGHT_NAME)
    if oldHighlight then oldHighlight:Destroy() end
    local head = character:FindFirstChild("Head")
    local oldBillboard = head and head:FindFirstChild(BILLBOARD_NAME)
    if oldBillboard then oldBillboard:Destroy() end
end

local function addESP(character, username)
    if not ESP_ENABLED or not character or espTracked[character] then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    if not humanoid or not head or humanoid.Health <= 0 then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = HIGHLIGHT_NAME
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = BILLBOARD_NAME
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(100, 25)
    billboard.StudsOffset = Vector3.new(0, -3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = MAX_DISTANCE
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Name = "Username"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = username or character.Name
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    espTracked[character] = {
        highlight = highlight,
        billboard = billboard,
        label = label,
    }
end

local function addPlayerESP(player, character)
    if not ESP_ENABLED or not player or not character then return end
    task.spawn(function()
        local head = character:WaitForChild("Head", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if ESP_ENABLED and head and humanoid and player.Parent == Players then
            addESP(character, player.Name)
        end
    end)
end

local function clearAllESP()
    local characters = {}
    for character in pairs(espTracked) do
        table.insert(characters, character)
    end
    for _, character in ipairs(characters) do removeESP(character) end
end

local function enableESP()
    ESP_ENABLED = true
    EspEnabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then addPlayerESP(player, player.Character) end
    end
end

local function disableESP()
    ESP_ENABLED = false
    EspEnabled = false
    clearAllESP()
end

trackConnection(Players.PlayerAdded:Connect(function(player)
    trackConnection(player.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        if ESP_ENABLED then addPlayerESP(player, character) end
    end))
end))

for _, player in ipairs(Players:GetPlayers()) do
    trackConnection(player.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        if ESP_ENABLED then addPlayerESP(player, character) end
    end))
end

trackConnection(Players.PlayerRemoving:Connect(function(player)
    if player.Character then removeESP(player.Character) end
end))

--------------------------------------------------
-- CLICK TELEPORT WINDOW
--------------------------------------------------
local function closeClickTeleportGui()
    for _, connection in ipairs(clickTeleportConnections) do
        if connection.Connected then connection:Disconnect() end
    end
    table.clear(clickTeleportConnections)
    if clickTeleportGui then
        clickTeleportGui:Destroy()
        clickTeleportGui = nil
    end
end

local function openClickTeleportGui()
    if menuClosed then return end
    if clickTeleportGui and clickTeleportGui.Parent then
        clickTeleportGui.Enabled = true
        return
    end

    local mouse = LocalPlayer:GetMouse()
    local minimized = false
    local heightOffset = 4
    local cooldown = 0.5
    local lastTeleport = 0

    local screen = Instance.new("ScreenGui")
    screen.Name = "YelimClickTeleport"
    screen.ResetOnSpawn = false
    screen.Parent = PlayerGui
    clickTeleportGui = screen

    local panel = Instance.new("Frame")
    panel.Size = UDim2.fromOffset(280, 205)
    panel.Position = UDim2.new(0.5, -140, 0.5, -102)
    panel.BackgroundColor3 = Color3.fromRGB(22, 22, 27)
    panel.BorderSizePixel = 0
    panel.Active = true
    panel.Draggable = true
    panel.ClipsDescendants = true
    panel.Parent = screen
    makeCorner(panel, 10)
    makeStroke(panel, Color3.fromRGB(255, 255, 255), 1)
    animatePanelOpen(panel, UDim2.fromOffset(280, 205), UDim2.new(0.5, -140, 0.5, -102))

    local title = makeText(panel, "Title", "YELIM | CLICK TELEPORT",
        UDim2.new(1, -85, 0, 38), UDim2.fromOffset(12, 0), 14, Enum.Font.GothamBold)
    title.TextXAlignment = Enum.TextXAlignment.Left

    local minimize = makeButton(panel, "Minimize", "−", UDim2.fromOffset(30, 28), UDim2.new(1, -68, 0, 5))
    local close = makeButton(panel, "Close", "X", UDim2.fromOffset(30, 28), UDim2.new(1, -34, 0, 5))
    local state = makeText(panel, "Status", "STATUS: ON", UDim2.new(1, -24, 0, 25), UDim2.fromOffset(12, 45), 13)
    local toggle = makeButton(panel, "Toggle", "TELEPORT: ON", UDim2.new(1, -24, 0, 36), UDim2.fromOffset(12, 75))
    local heightLabel = makeText(panel, "Height", "Teleport height: 4", UDim2.new(1, -24, 0, 24), UDim2.fromOffset(12, 117), 13)
    local lower = makeButton(panel, "LowerHeight", "−", UDim2.fromOffset(65, 30), UDim2.fromOffset(50, 158))
    local raise = makeButton(panel, "RaiseHeight", "+", UDim2.fromOffset(65, 30), UDim2.fromOffset(165, 158))

    local function refresh()
        state.Text = clickTeleportEnabled and "STATUS: ON" or "STATUS: OFF"
        state.TextColor3 = clickTeleportEnabled and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(255, 120, 120)
        toggle.Text = clickTeleportEnabled and "TELEPORT: ON" or "TELEPORT: OFF"
        toggle.BackgroundColor3 = clickTeleportEnabled and Color3.fromRGB(25, 100, 55) or Color3.fromRGB(43, 43, 52)
    end

    table.insert(clickTeleportConnections, toggle.Activated:Connect(function()
        clickTeleportEnabled = not clickTeleportEnabled
        refresh()
    end))
    table.insert(clickTeleportConnections, raise.Activated:Connect(function()
        heightOffset = math.min(heightOffset + 2, 50)
        heightLabel.Text = "Teleport height: " .. heightOffset
    end))
    table.insert(clickTeleportConnections, lower.Activated:Connect(function()
        heightOffset = math.max(heightOffset - 2, 0)
        heightLabel.Text = "Teleport height: " .. heightOffset
    end))
    -- Minimize to a clean title bar: hide ALL text/content except the two controls.
    local visibilityBeforeMinimize = {}
    for _, child in ipairs(panel:GetDescendants()) do
        if child:IsA("GuiObject") and child ~= minimize and child ~= close and child ~= title then
            visibilityBeforeMinimize[child] = child.Visible
        end
    end
    table.insert(clickTeleportConnections, minimize.Activated:Connect(function()
        minimized = not minimized
        if minimized then
            for object in pairs(visibilityBeforeMinimize) do
                if object and object.Parent then object.Visible = false end
            end
            tweenObject(panel, TWEEN_MED, {Size = UDim2.fromOffset(280, 38)})
            minimize.Text = "+"
        else
            for object, wasVisible in pairs(visibilityBeforeMinimize) do
                if object and object.Parent then object.Visible = wasVisible end
            end
            panel.Size = UDim2.fromOffset(280, 38)
            tweenObject(panel, TWEEN_SPRING, {Size = UDim2.fromOffset(280, 205)})
            minimize.Text = "−"
        end
        minimize.Visible = true
        close.Visible = true
    end))
    table.insert(clickTeleportConnections, close.Activated:Connect(closeClickTeleportGui))
    table.insert(clickTeleportConnections, UserInputService.InputBegan:Connect(function(input, processed)
        if processed or menuClosed or not clickTeleportEnabled or not clickTeleportGui then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if os.clock() - lastTeleport < cooldown then return end
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then return end
        local target = mouse.Hit
        if not target then return end
        lastTeleport = os.clock()
        root.CFrame = CFrame.new(target.Position + Vector3.new(0, heightOffset, 0)) * root.CFrame.Rotation
    end))
    refresh()
end

--------------------------------------------------
-- FLY WINDOW / MOVEMENT
--------------------------------------------------
local function stopFly()
    flyEnabled = false
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
    if flyGyro then flyGyro:Destroy(); flyGyro = nil end
end

local function startFly()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then return false end

    stopFly()
    flyEnabled = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "YelimFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "YelimFlyGyro"
    flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flyGyro.P = 9000
    flyGyro.D = 500
    flyGyro.CFrame = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or root.CFrame
    flyGyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flyEnabled or not root.Parent or not humanoid.Parent or humanoid.Health <= 0 then
            stopFly()
            return
        end
        local camera = workspace.CurrentCamera
        if not camera or not flyVelocity or not flyGyro then return end
        local vertical = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            vertical = 1
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vertical = -1
        end
        flyVelocity.Velocity = humanoid.MoveDirection * flySpeed + Vector3.new(0, vertical * flySpeed, 0)
        flyGyro.CFrame = camera.CFrame
    end)
    return true
end

local function closeFlyGui(stopFlight)
    if stopFlight then stopFly() end
    for _, connection in ipairs(flyGuiConnections) do
        if connection.Connected then connection:Disconnect() end
    end
    table.clear(flyGuiConnections)
    if flyGui then flyGui:Destroy(); flyGui = nil end
    flyToggleButton = nil
end

local function openFlyGui()
    if menuClosed then return end
    if flyGui and flyGui.Parent then flyGui.Enabled = true; return end

    flyGui = Instance.new("ScreenGui")
    flyGui.Name = "YelimFlyGUI"
    flyGui.ResetOnSpawn = false
    flyGui.Parent = PlayerGui

    local panel = Instance.new("Frame")
    panel.Name = "FlyPanel"
    panel.Size = UDim2.fromOffset(280, 210)
    panel.Position = UDim2.new(0.5, -140, 0.5, -105)
    panel.BackgroundColor3 = Color3.fromRGB(22, 22, 27)
    panel.BorderSizePixel = 0
    panel.Active = true
    panel.Draggable = true
    panel.ClipsDescendants = true
    panel.Parent = flyGui
    makeCorner(panel, 10)
    makeStroke(panel, Color3.fromRGB(255, 255, 255), 1)
    animatePanelOpen(panel, UDim2.fromOffset(280, 210), UDim2.new(0.5, -140, 0.5, -102))

    local title = makeText(panel, "Title", "YELIM | FLY",
        UDim2.new(1, -85, 0, 38), UDim2.fromOffset(12, 0), 14, Enum.Font.GothamBold)
    title.TextXAlignment = Enum.TextXAlignment.Left
    local minimize = makeButton(panel, "Minimize", "−", UDim2.fromOffset(30, 28), UDim2.new(1, -68, 0, 5))
    local close = makeButton(panel, "Close", "X", UDim2.fromOffset(30, 28), UDim2.new(1, -34, 0, 5))
    local statusLabel = makeText(panel, "Status", "STATUS: OFF", UDim2.new(1, -24, 0, 25), UDim2.fromOffset(12, 42), 13)
    statusLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
    flyToggleButton = makeButton(panel, "ToggleFly", "FLY: OFF", UDim2.new(1, -24, 0, 36), UDim2.fromOffset(12, 72))
    local speedLabel = makeText(panel, "Speed", "FLY SPEED: " .. flySpeed, UDim2.new(1, -24, 0, 25), UDim2.fromOffset(12, 114), 13)
    local slower = makeButton(panel, "Slower", "− SPEED", UDim2.fromOffset(110, 32), UDim2.fromOffset(18, 154))
    local faster = makeButton(panel, "Faster", "+ SPEED", UDim2.fromOffset(110, 32), UDim2.fromOffset(152, 154))
    local minimized = false

    table.insert(flyGuiConnections, flyToggleButton.Activated:Connect(function()
        if flyEnabled then stopFly() else startFly() end
        local on = flyEnabled
        flyToggleButton.Text = on and "FLY" or "FLY: OFF"
        flyToggleButton.BackgroundColor3 = on and Color3.fromRGB(25, 120, 60) or Color3.fromRGB(60, 60, 60)
        statusLabel.Text = on and "STATUS: ON" or "STATUS: OFF"
        statusLabel.TextColor3 = on and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(255, 120, 120)
    end))
    table.insert(flyGuiConnections, slower.Activated:Connect(function()
        flySpeed = math.max(10, flySpeed - 10)
        speedLabel.Text = "FLY SPEED: " .. flySpeed
    end))
    table.insert(flyGuiConnections, faster.Activated:Connect(function()
        flySpeed = math.min(200, flySpeed + 10)
        speedLabel.Text = "FLY SPEED: " .. flySpeed
    end))
    -- Minimize to a clean title bar: hide ALL text/content except the two controls.
    local visibilityBeforeMinimize = {}
    for _, child in ipairs(panel:GetDescendants()) do
        if child:IsA("GuiObject") and child ~= minimize and child ~= close and child ~= title then
            visibilityBeforeMinimize[child] = child.Visible
        end
    end
    table.insert(flyGuiConnections, minimize.Activated:Connect(function()
        minimized = not minimized
        if minimized then
            for object in pairs(visibilityBeforeMinimize) do
                if object and object.Parent then object.Visible = false end
            end
            tweenObject(panel, TWEEN_MED, {Size = UDim2.fromOffset(280, 38)})
            minimize.Text = "+"
        else
            for object, wasVisible in pairs(visibilityBeforeMinimize) do
                if object and object.Parent then object.Visible = wasVisible end
            end
            panel.Size = UDim2.fromOffset(280, 38)
            tweenObject(panel, TWEEN_SPRING, {Size = UDim2.fromOffset(280, 210)})
            minimize.Text = "−"
        end
        minimize.Visible = true
        close.Visible = true
    end))
    table.insert(flyGuiConnections, close.Activated:Connect(function() closeFlyGui(true) end))
end

