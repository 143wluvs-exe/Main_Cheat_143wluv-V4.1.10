    UDim2.new(1, -36, 0, 34), UDim2.fromOffset(18, 121))
keySubmit.BackgroundColor3 = Color3.fromRGB(45, 105, 65)
keySubmit.ZIndex = 21

local keyStatus = makeText(keyFrame, "KeyStatus", "",
    UDim2.new(1, -20, 0, 22), UDim2.fromOffset(10, 158), 12)
keyStatus.ZIndex = 21
keyStatus.TextColor3 = Color3.fromRGB(255, 100, 100)

local loadingFrame = Instance.new("Frame")
loadingFrame.Name = "KeyLoading"
loadingFrame.Size = UDim2.fromOffset(340, 150)
loadingFrame.Position = UDim2.new(0.5, -170, 0.5, -75)
loadingFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 27)
loadingFrame.BorderSizePixel = 0
loadingFrame.Visible = false
loadingFrame.ZIndex = 30
loadingFrame.Parent = gui
makeCorner(loadingFrame, 12)
makeStroke(loadingFrame, Color3.fromRGB(255, 255, 255), 1)

makeText(loadingFrame, "LoadingTitle", "143wluv$ | LOADING",
    UDim2.new(1, -20, 0, 35), UDim2.fromOffset(10, 20), 18, Enum.Font.GothamBold).ZIndex = 31
local loadingInfo = makeText(loadingFrame, "LoadingInfo", "Key unlocked. Loading main menu...",
    UDim2.new(1, -20, 0, 28), UDim2.fromOffset(10, 62), 13)
loadingInfo.ZIndex = 31

local barBack = Instance.new("Frame")
barBack.Size = UDim2.new(1, -40, 0, 8)
barBack.Position = UDim2.fromOffset(20, 108)
barBack.BackgroundColor3 = Color3.fromRGB(55, 55, 65)
barBack.BorderSizePixel = 0
barBack.ZIndex = 31
barBack.Parent = loadingFrame
makeCorner(barBack, 8)

local loadingBar = Instance.new("Frame")
loadingBar.Size = UDim2.new(0, 0, 1, 0)
loadingBar.BackgroundColor3 = Color3.fromRGB(90, 220, 130)
loadingBar.BorderSizePixel = 0
loadingBar.ZIndex = 32
loadingBar.Parent = barBack
makeCorner(loadingBar, 8)

task.delay(1, function()
    if not menuClosed and gui and gui.Parent then
        keyFrame.Visible = true
        keyFrame.BackgroundTransparency = 1
        tweenObject(keyFrame, TWEEN_MED, {BackgroundTransparency = 0})
    end
end)

local keyAccepted = false
local function submitKey()
    if keyAccepted or menuClosed then return end
    if keyBox.Text ~= REQUIRED_KEY then
        keyStatus.Text = "Wrong key. Please try again."
        keyBox.Text = ""
        keyBox:CaptureFocus()
        return
    end

    keyAccepted = true
    keyStatus.TextColor3 = Color3.fromRGB(100, 255, 140)
    keyStatus.Text = "Key accepted!"
    keyFrame.Visible = false
    loadingFrame.Visible = true
    keySubmit.Active = false
    keySubmit.AutoButtonColor = false

    task.spawn(function()
        local startTime = os.clock()
        while os.clock() - startTime < 5 do
            if menuClosed or not gui or not gui.Parent then return end
            local progress = math.clamp((os.clock() - startTime) / 5, 0, 1)
            loadingBar.Size = UDim2.new(progress, 0, 1, 0)
            loadingInfo.Text = "Loading main menu... " .. math.floor(progress * 100) .. "%"
            task.wait(0.05)
        end
        if menuClosed or not gui or not gui.Parent then return end
        keyFrame:Destroy()
        loadingFrame:Destroy()
        box.Visible = false
        box.Size = UDim2.fromOffset(540, 380)
        box.Position = UDim2.new(0.5, -270, 0.5, -190)
        box.BackgroundTransparency = 1
        box.Visible = true
        tweenObject(box, TWEEN_SPRING, {
            Size = UDim2.fromOffset(580, 410),
            Position = UDim2.new(0.5, -290, 0.5, -205),
            BackgroundTransparency = 0
        })
    end)
end

trackConnection(keySubmit.Activated:Connect(submitKey))
trackConnection(keyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then submitKey() end
end))

--------------------------------------------------
-- CLOSE / CLEANUP
--------------------------------------------------
local function stopAll()
    if menuClosed then return end
    menuClosed = true

    AimEnabled = false
    EspEnabled = false
    BigheadEnabled = false
    flyEnabled = false
    flingEnabled = false
    if noClipEnabled then setNoClip(false) end
    if flingGui then flingGui:Destroy(); flingGui = nil end
    disableESP()
    restoreBigHeads()
    closeClickTeleportGui()
    closeFlyGui(true)
    stopFly()
    flyToggleButton = nil

    -- Destroy any remaining UI owned by this script, including a minimized restore pill.
    if restoreBtn then
        restoreBtn:Destroy()
        restoreBtn = nil
    end

    -- Remove every GUI owned by this script so close fully shuts down the interface.
    for _, name in ipairs({"YelimClickTeleport", "YelimFlyGUI", "YelimWhiteDarkFling", "YelimPanelGUI"}) do
        local leftover = PlayerGui:FindFirstChild(name)
        if leftover then leftover:Destroy() end
    end

    for _, connection in ipairs(connections) do
        if connection.Connected then connection:Disconnect() end
    end
    table.clear(connections)

    if gui then
        gui:Destroy()
        gui = nil
    end
end

trackConnection(closeBtn.Activated:Connect(stopAll))

trackConnection(LocalPlayer.CharacterAdded:Connect(function()
    stopFly()
    if flyToggleButton and flyToggleButton.Parent then
        flyToggleButton.Text = "FLY: OFF"
        flyToggleButton.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
    end
end))

--------------------------------------------------
-- RENDER LOOP
--------------------------------------------------
trackConnection(RunService.RenderStepped:Connect(function()
    if menuClosed or not gui or not gui.Parent then return end

    if AimEnabled then
        aimAtTarget()
    end

    if ESP_ENABLED then
        local color = rainbowColor()
        for character, data in pairs(espTracked) do
            if not character.Parent or not data.highlight.Parent or not data.billboard.Parent then
                removeESP(character)
            else
                data.highlight.FillColor = color
                data.highlight.OutlineColor = color
                data.label.TextColor3 = color
            end
        end
    end
end))

showPage("MAIN")
