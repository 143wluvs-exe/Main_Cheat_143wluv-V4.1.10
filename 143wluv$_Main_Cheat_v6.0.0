local function openFlingGui()
    if menuClosed then return end
    if flingGui and flingGui.Parent then
        flingGui.Enabled = true
        return
    end

    -- White-and-dark Touch Fling panel, opened from the main panel button.
    flingGui = Instance.new("ScreenGui")
    flingGui.Name = "YelimWhiteDarkFling"
    flingGui.Parent = PlayerGui
    flingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    flingGui.ResetOnSpawn = false

    local frame = Instance.new("Frame")
    frame.Name = "FlingFrame"
    frame.Parent = flingGui
    frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    frame.BorderColor3 = Color3.fromRGB(255, 255, 255)
    frame.BorderSizePixel = 2
    frame.Position = UDim2.new(0.341826946, 0, 0.367763907, 0)
    frame.Size = UDim2.new(0, 148, 0, 106)
    frame.Active = true
    frame.Draggable = true

    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "FlingToggle"
    toggleButton.Parent = frame
    toggleButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    toggleButton.BorderColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.BorderSizePixel = 2
    toggleButton.Position = UDim2.new(0.0835492909, 0, 0.552504063, 0)
    toggleButton.Size = UDim2.new(0, 124, 0, 37)
    toggleButton.Font = Enum.Font.SourceSans
    toggleButton.Text = "OFF"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextSize = 41

    local title = Instance.new("TextLabel")
    title.Name = "FlingTitle"
    title.Parent = frame
    title.BackgroundTransparency = 1
    title.BorderSizePixel = 0
    title.Position = UDim2.new(0.0649713054, 0, 0.0727680102, 0)
    title.Size = UDim2.new(0, 128, 0, 39)
    title.Font = Enum.Font.SourceSans
    title.Text = "Touch Fling"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 34

    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local flingRunService = game:GetService("RunService")
    local hiddenfling = false
    flingEnabled = true

    if not ReplicatedStorage:FindFirstChild("juisdfj0i32i0eidsuf0iok") then
        local detection = Instance.new("Decal")
        detection.Name = "juisdfj0i32i0eidsuf0iok"
        detection.Parent = ReplicatedStorage
    end

    local function fling()
        local hrp, c, vel, movel = nil, nil, nil, 0.1
        local lp = Players.LocalPlayer

        while flingEnabled and flingGui and flingGui.Parent do
            flingRunService.Heartbeat:Wait()
            if hiddenfling then
                while hiddenfling and flingEnabled and not (c and c.Parent and hrp and hrp.Parent) do
                    flingRunService.Heartbeat:Wait()
                    c = lp.Character
                    hrp = c and c:FindFirstChild("HumanoidRootPart")
                end

                if hiddenfling and flingEnabled then
                    vel = hrp.Velocity
                    hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
                    flingRunService.RenderStepped:Wait()
                    if c and c.Parent and hrp and hrp.Parent then
                        hrp.Velocity = vel
                    end
                    flingRunService.Stepped:Wait()
                    if c and c.Parent and hrp and hrp.Parent then
                        hrp.Velocity = vel + Vector3.new(0, movel, 0)
                        movel = movel * -1
                    end
                end
            end
        end
    end

    toggleButton.MouseButton1Click:Connect(function()
        hiddenfling = not hiddenfling
        toggleButton.Text = hiddenfling and "ON" or "OFF"
    end)

    task.spawn(fling)
end

local function paintToggle(button, on, onText, offText)
    if not button or not button.Parent then return end
    button.Text = on and onText or offText
    button.BackgroundColor3 = on and Color3.fromRGB(25, 120, 60) or Color3.fromRGB(38, 38, 44)
end

--------------------------------------------------
-- NO CLIP (MAIN2 TOGGLE)
--------------------------------------------------
local noClipEnabled = false
local noClipConnection
local noClipCharacterConnection
local noClipOriginalCollision = {}

local function saveNoClipCollision(character)
    table.clear(noClipOriginalCollision)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            noClipOriginalCollision[part] = part.CanCollide
        end
    end
end

local function restoreNoClipCollision()
    for part, canCollide in pairs(noClipOriginalCollision) do
        if part and part.Parent then
            part.CanCollide = canCollide
        end
    end
    table.clear(noClipOriginalCollision)
end

local function setNoClip(enabled)
    noClipEnabled = enabled
    if noClipConnection then
        noClipConnection:Disconnect()
        noClipConnection = nil
    end

    local character = LocalPlayer.Character
    if enabled then
        if character then saveNoClipCollision(character) end
        noClipConnection = RunService.Stepped:Connect(function()
            local currentCharacter = LocalPlayer.Character
            if not currentCharacter then return end
            for _, part in ipairs(currentCharacter:GetDescendants()) do
                if part:IsA("BasePart") then
                    if noClipOriginalCollision[part] == nil then
                        noClipOriginalCollision[part] = part.CanCollide
                    end
                    part.CanCollide = false
                end
            end
        end)
    else
        restoreNoClipCollision()
    end

    paintToggle(noClipButton, noClipEnabled, "NO CLIP: ON", "NO CLIP: OFF")
    setStatus(noClipEnabled and "NO CLIP ON" or "NO CLIP OFF", noClipEnabled)
end

trackConnection(noClipButton.Activated:Connect(function()
    setNoClip(not noClipEnabled)
end))

noClipCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
    task.wait(0.25)
    if noClipEnabled then
        saveNoClipCollision(character)
    end
end)
trackConnection(noClipCharacterConnection)

