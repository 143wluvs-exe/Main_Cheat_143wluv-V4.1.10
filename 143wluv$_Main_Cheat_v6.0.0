trackConnection(flingMainButton.Activated:Connect(function()
    if menuClosed or flingButtonClickDebounce then return end

    -- If the fling GUI is already open, do not restart the audio.
    if flingGui and flingGui.Parent then
        flingGui.Enabled = true
        return
    end

    flingButtonClickDebounce = true
    -- Wait one second before showing the GUI and playing the audio together.
    task.wait(1)

    if not menuClosed then
        local guiWasAlreadyOpen = flingGui and flingGui.Parent
        openFlingGui()
        if not guiWasAlreadyOpen and not flingAudioPlayed then
            flingAudioPlayed = true
            flingButtonClickSound:Play()
        end
    end
    flingButtonClickDebounce = false
end))

