    UDim2.new(1, -20, 0, 35), UDim2.fromOffset(10, 8), 17, Enum.Font.GothamBold).ZIndex = 21
makeText(keyFrame, "KeyInfo", "Enter your key password to continue.",
    UDim2.new(1, -24, 0, 25), UDim2.fromOffset(12, 42), 13).ZIndex = 21

