local flingButtonClickDebounce = false
local flingAudioPlayed = false
local flingButtonClickSound = Instance.new("Sound")
flingButtonClickSound.Name = "WhiteDarkFlingClickSound"
flingButtonClickSound.SoundId = "rbxassetid://6308606116"
flingButtonClickSound.Volume = 0.7
flingButtonClickSound.Looped = false
