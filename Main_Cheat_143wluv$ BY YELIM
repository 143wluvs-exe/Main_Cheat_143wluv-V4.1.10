    speedLabel.TextColor3 = Color3.new(1, 1, 1)
    speedLabel.Text = "FLY SPEED: " .. flySpeed
    speedLabel.TextSize = 13
    speedLabel.Font = Enum.Font.Gotham
    speedLabel.Parent = panel
    local slower = makeFlyButton("Slower", "− SPEED", UDim2.fromOffset(110, 32), UDim2.fromOffset(18, 154))
    local faster = makeFlyButton("Faster", "+ SPEED", UDim2.fromOffset(110, 32), UDim2.fromOffset(152, 154))

    local minimized = false
    trackFlyGuiConnection(flyToggleButton.Activated:Connect(function()
        if flyEnabled then
            stopFly()
        else
            startFly()
        end
        local isOn = flyEnabled
        flyToggleButton.Text = isOn and "FLY: ON" or "FLY: OFF"
        flyToggleButton.BackgroundColor3 = isOn and Color3.fromRGB(25, 120, 60) or Color3.fromRGB(60, 60, 60)
        statusLabel.Text = isOn and "STATUS: ON | WASD MOVE, SPACE UP, CTRL DOWN" or "STATUS: OFF"
        statusLabel.TextColor3 = isOn and Color3.fromRGB(120, 255, 150) or Color3.fromRGB(255, 120, 120)
    end))
    trackFlyGuiConnection(slower.Activated:Connect(function()
        flySpeed = math.max(10, flySpeed - 10)
        speedLabel.Text = "FLY SPEED: " .. flySpeed
    end))
    trackFlyGuiConnection(faster.Activated:Connect(function()
        flySpeed = math.min(200, flySpeed + 10)
        speedLabel.Text = "FLY SPEED: " .. flySpeed
    end))
    trackFlyGuiConnection(minimize.Activated:Connect(function()
        minimized = not minimized
        statusLabel.Visible = not minimized
        flyToggleButton.Visible = not minimized
        speedLabel.Visible = not minimized
        slower.Visible = not minimized
        faster.Visible = not minimized
        panel.Size = minimized and UDim2.fromOffset(280, 38) or UDim2.fromOffset(280, 210)
        minimize.Text = minimized and "+" or "−"
    end))
    trackFlyGuiConnection(close.Activated:Connect(function()
        closeFlyGui(true)
    end))
end

