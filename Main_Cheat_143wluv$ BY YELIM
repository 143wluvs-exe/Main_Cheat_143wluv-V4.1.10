local flyEnabled = false
local flySpeed = 60
local flyVelocity = nil
local flyGyro = nil
local flyConnection = nil
local flyGui = nil
local flyGuiConnections = {}
local flyToggleButton = nil

local function trackFlyGuiConnection(connection)
    table.insert(flyGuiConnections, connection)
    return connection
end

stopFly = function()
    flyEnabled = false
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end
    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end
end

local function startFly()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        return false
    end

    stopFly()
    flyEnabled = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "YelimFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "YelimFlyGyro"
    flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flyGyro.P = 9000
    flyGyro.D = 500
    flyGyro.CFrame = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or root.CFrame
    flyGyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flyEnabled or not root.Parent or not humanoid.Parent or humanoid.Health <= 0 then
            stopFly()
            if flyToggleButton and flyToggleButton.Parent then
                flyToggleButton.Text = "FLY: OFF"
                flyToggleButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            end
            return
        end

        local camera = workspace.CurrentCamera
        if not camera or not flyVelocity or not flyGyro then return end

        local vertical = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            vertical = 1
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vertical = -1
        end
        flyVelocity.Velocity = humanoid.MoveDirection * flySpeed + Vector3.new(0, vertical * flySpeed, 0)
        flyGyro.CFrame = camera.CFrame
    end)
    return true
end

closeFlyGui = function(stopFlight)
    if stopFlight then stopFly() end
    for _, connection in ipairs(flyGuiConnections) do
        if connection.Connected then connection:Disconnect() end
    end
    table.clear(flyGuiConnections)
    if flyGui then
        flyGui:Destroy()
        flyGui = nil
    end
    flyToggleButton = nil
end

