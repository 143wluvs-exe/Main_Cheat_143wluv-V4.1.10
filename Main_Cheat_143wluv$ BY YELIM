--------------------------------------------------
-- BIGHEAD (LOCAL VISUAL EFFECT FOR ALL PLAYERS)
-- For a live game, changes to other players must be
-- applied by a server Script to replicate to everyone.
--------------------------------------------------

local HEAD_SIZE = 4
local HEAD_TRANSPARENCY = 0.7
local HEAD_CAN_COLLIDE = false
local originalHeadProperties = {}

local function applyBigHead(character)
    if not BigheadEnabled or not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    if not humanoid or not head or not head:IsA("BasePart") then return end

    if not originalHeadProperties[head] then
        originalHeadProperties[head] = {
            Size = head.Size,
            Transparency = head.Transparency,
            CanCollide = head.CanCollide,
        }
    end

    local original = originalHeadProperties[head]
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        head.Size = Vector3.new(HEAD_SIZE, HEAD_SIZE, HEAD_SIZE)
    else
        head.Size = original.Size * HEAD_SIZE
    end
    head.Transparency = HEAD_TRANSPARENCY
    head.CanCollide = HEAD_CAN_COLLIDE
end

local function restoreBigHeads()
    BigheadEnabled = false
    for head, original in pairs(originalHeadProperties) do
        if head and head.Parent then
            head.Size = original.Size
            head.Transparency = original.Transparency
            head.CanCollide = original.CanCollide
        end
    end
    table.clear(originalHeadProperties)
end

local function applyBigHeadToAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            applyBigHead(player.Character)
        end
    end
end

-- Keep newly joining players and respawns in sync with the toggle.
for _, player in ipairs(Players:GetPlayers()) do
    trackConnection(player.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        if BigheadEnabled and not menuClosed then
            applyBigHead(character)
        end
    end))
end

trackConnection(Players.PlayerAdded:Connect(function(player)
    trackConnection(player.CharacterAdded:Connect(function(character)
        task.wait(0.2)
        if BigheadEnabled and not menuClosed then
            applyBigHead(character)
        end
    end))
    if player.Character and BigheadEnabled then
        applyBigHead(player.Character)
    end
end))

local function stopAll()
    if menuClosed then
        return
    end

    menuClosed = true

    if closeClickTeleportGui then
        closeClickTeleportGui()
    end
    if closeFlyGui then
        closeFlyGui(true)
    elseif stopFly then
        stopFly()
