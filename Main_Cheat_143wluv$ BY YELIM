    if input.KeyCode == Enum.KeyCode.F then
        if flyEnabled then
            stopFly()
        else
            startFly()
        end
        if flyToggleButton and flyToggleButton.Parent then
            flyToggleButton.Text = flyEnabled and "FLY: ON" or "FLY: OFF"
            flyToggleButton.BackgroundColor3 = flyEnabled and Color3.fromRGB(25, 120, 60) or Color3.fromRGB(60, 60, 60)
        end
    end
end))

