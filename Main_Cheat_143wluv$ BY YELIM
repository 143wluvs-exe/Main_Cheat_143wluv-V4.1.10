    AimEnabled = false
    EspEnabled = false
    restoreBigHeads()

    for _, connection in ipairs(connections) do
        if connection.Connected then
            connection:Disconnect()
        end
    end

    table.clear(connections)

    if gui then
        gui:Destroy()
        gui = nil
    end
end

--------------------------------------------------
-- TARGET FUNCTIONS
--------------------------------------------------

local function getTargetPart(character)
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")

    if head then
        return head.Position
    elseif root then
        return root.Position
    end

    return nil
end

local function getClosestPlayer()
    local camera = workspace.CurrentCamera
    if not camera then
        return nil
    end

    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter
        and myCharacter:FindFirstChild("HumanoidRootPart")

    if not myRoot then
        return nil
    end

    local closestTarget = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local character = player.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")
            local targetPos = getTargetPart(character)

            if humanoid and humanoid.Health > 0
                and root and targetPos then

                local _, onScreen =
                    camera:WorldToScreenPoint(targetPos)

                if onScreen then
                    local offset = targetPos - camera.CFrame.Position

                    if offset.Magnitude > 0 then
                        local angle = math.deg(math.acos(math.clamp(
                            camera.CFrame.LookVector:Dot(offset.Unit),
                            -1,
                            1
                        )))

                        local distance =
                            (myRoot.Position - targetPos).Magnitude

                        if angle <= FOV and distance < shortestDistance then
                            shortestDistance = distance
                            closestTarget = targetPos
                        end
                    end
                end
            end
        end
    end

    return closestTarget
end

local function aimAtTarget()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    local target = getClosestPlayer()

    if target then
        local targetCFrame =
            CFrame.new(camera.CFrame.Position, target)

        camera.CFrame =
            camera.CFrame:Lerp(targetCFrame, Smoothness)
    end
end

--------------------------------------------------
-- YELIM RAINBOW ESP
--------------------------------------------------

local ESP_ENABLED = false
local RAINBOW_SPEED = 0.5
local MAX_DISTANCE = 1000
local HIGHLIGHT_NAME = "YelimRainbowESP"
local BILLBOARD_NAME = "YelimUsernameESP"
local espTracked = {}

local function rainbowColor()
    return Color3.fromHSV((os.clock() * RAINBOW_SPEED) % 1, 1, 1)
end

local function removeESP(character)
    if not character then return end

    local data = espTracked[character]
    if data then
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
        espTracked[character] = nil
    end

    -- Also remove leftovers if the character had a previous ESP instance.
    local oldHighlight = character:FindFirstChild(HIGHLIGHT_NAME)
    if oldHighlight then oldHighlight:Destroy() end

    local head = character:FindFirstChild("Head")
    if head then
        local oldBillboard = head:FindFirstChild(BILLBOARD_NAME)
        if oldBillboard then oldBillboard:Destroy() end
    end
end

local function addESP(character, username)
    if not ESP_ENABLED or not character or espTracked[character] then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    if not humanoid or not head or humanoid.Health <= 0 then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = HIGHLIGHT_NAME
    highlight.Adornee = character
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = BILLBOARD_NAME
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(50, 38)
    billboard.StudsOffset = Vector3.new(0, -4, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = MAX_DISTANCE
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Name = "Username"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = username or character.Name
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    espTracked[character] = {
        highlight = highlight,
        billboard = billboard,
        label = label
    }
end

local function addPlayerCharacterESP(player, character)
    if not ESP_ENABLED or not player or not character then return end

    task.spawn(function()
        local head = character:WaitForChild("Head", 10)
        local humanoid = character:WaitForChild("Humanoid", 10)
        if ESP_ENABLED and head and humanoid and player.Parent == Players then
            addESP(character, player.Name)
        end
    end)
end

local function clearAllESP()
    local characters = {}
    for character in pairs(espTracked) do
        table.insert(characters, character)
    end
    for _, character in ipairs(characters) do
        removeESP(character)
    end
end

local function enableESP()
    ESP_ENABLED = true

    -- Player characters only; NPC scanning has been removed.
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            addPlayerCharacterESP(player, player.Character)
        end
    end
end

disableESP = function()
    ESP_ENABLED = false
    clearAllESP()
end

-- Track player joins and respawns only.
trackConnection(Players.PlayerAdded:Connect(function(player)
    trackConnection(player.CharacterAdded:Connect(function(character)
        addPlayerCharacterESP(player, character)
    end))
    if player.Character then
        addPlayerCharacterESP(player, player.Character)
    end
end))

for _, player in ipairs(Players:GetPlayers()) do
    trackConnection(player.CharacterAdded:Connect(function(character)
        addPlayerCharacterESP(player, character)
    end))
end

trackConnection(Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        removeESP(player.Character)
    end
end))

-- Update rainbow colors while ESP is enabled.
trackConnection(RunService.RenderStepped:Connect(function()
    if not ESP_ENABLED then return end

    local color = rainbowColor()
    for character, data in pairs(espTracked) do
        if not character.Parent or not data.highlight.Parent or not data.billboard.Parent then
            removeESP(character)
        else
            data.highlight.FillColor = color
            data.highlight.OutlineColor = color
            data.label.TextColor3 = color
        end
    end
end))

