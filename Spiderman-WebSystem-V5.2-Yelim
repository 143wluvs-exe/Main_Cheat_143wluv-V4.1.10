
--// YELIM SPIDER-MAN WEB SYSTEM | V5.2
--// LocalScript inside StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- SETTINGS
local MAX_WEBS = 5
local WEB_HEIGHT = 55
local WEB_SPREAD = 12
local WEB_THICKNESS = 0.1
local RETRACT_SPEED = 260
local LAUNCH_SPEED = 150
local UPWARD_SPEED = 22
local LAUNCH_DURATION = 0.9
local SWING_PULL = 22

-- STATE
local webs = {}
local enabled = true
local swinging = false
local launching = false
local retracting = false
local launchTime = 0
local connections = {}
local characterConnection
local closed = false

local gui
local frame
local title
local statusLabel
local countLabel
local toggleButton
local restoreButton

local function getCharacter()
    return player.Character
end

local function getRoot()
    local character = getCharacter()
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = getCharacter()
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function setStatus(message)
    if not closed and statusLabel and statusLabel.Parent then
        statusLabel.Text = message
    end
end

local function removeWeb(web)
    if not web then return end

    for _, object in ipairs(web.objects or {}) do
        if object and object.Parent then
            object:Destroy()
        end
    end

    for i = #webs, 1, -1 do
        if webs[i] == web then
            table.remove(webs, i)
            break
        end
    end
end

local function releaseAll()
    swinging = false
    launching = false
    retracting = false
    launchTime = 0

    for i = #webs, 1, -1 do
        removeWeb(webs[i])
    end

    setStatus("All webs released")
end

-- CLEANUP EVERYTHING ON CLOSE
local function shutdown()
    if closed then return end
    closed = true

    enabled = false
    swinging = false
    launching = false
    retracting = false

    for i = #webs, 1, -1 do
        removeWeb(webs[i])
    end

    for _, connection in ipairs(connections) do
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
    table.clear(connections)

    if characterConnection then
        characterConnection:Disconnect()
        characterConnection = nil
    end

    if gui and gui.Parent then
        gui:Destroy()
    end
end

-- CREATE WEB
local function createWeb(root, targetPosition, index)
    local start = Instance.new("Attachment")
    start.Name = "YelimWebStart" .. index
    start.Position = Vector3.new(
        ((index - 1) % 3 - 1) * 0.45,
        1.1,
        -0.3
    )
    start.Parent = root

    local anchor = Instance.new("Part")
    anchor.Name = "YelimWebAnchor" .. index
    anchor.Size = Vector3.new(0.15, 0.15, 0.15)
    anchor.Transparency = 1
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.Position = targetPosition
    anchor.Parent = workspace

    local finish = Instance.new("Attachment")
    finish.Name = "YelimWebEnd" .. index
    finish.Parent = anchor

    local beam = Instance.new("Beam")
    beam.Name = "YelimWebBeam" .. index
    beam.Attachment0 = start
    beam.Attachment1 = finish
    beam.Width0 = 0.01
    beam.Width1 = 0.01
    beam.FaceCamera = true
    beam.Segments = 12
    beam.LightEmission = 0.25
    beam.Color = ColorSequence.new(Color3.new(1, 1, 1))
    beam.Parent = root

    TweenService:Create(
        beam,
        TweenInfo.new(0.16, Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out),
        {
            Width0 = WEB_THICKNESS,
            Width1 = WEB_THICKNESS
        }
    ):Play()

    local web = {
        objects = {start, anchor, finish, beam},
        anchor = anchor,
        start = start,
        beam = beam,
        retracting = false
    }

    table.insert(webs, web)
    return web
end

-- SPIDER LAUNCH
local function spiderLaunch()
    if closed or not enabled then return end

    local root = getRoot()
    local humanoid = getHumanoid()

    if not root or not humanoid or humanoid.Health <= 0 then
        setStatus("Character not ready")
        return
    end

    releaseAll()

    local origin = root.Position
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    for i = 1, MAX_WEBS do
        local spread = (i - 3) * WEB_SPREAD
        local forwardOffset = math.abs(i - 3) * 5

        local targetPosition =
            origin
            + Vector3.new(0, WEB_HEIGHT, 0)
            + right * spread
            + forward * forwardOffset

        createWeb(root, targetPosition, i)
    end

    swinging = false
    retracting = false
    launching = true
    launchTime = 0

    root.AssemblyLinearVelocity =
        forward * LAUNCH_SPEED
        + Vector3.new(0, UPWARD_SPEED, 0)

    setStatus("SPIDER LAUNCH!")
end

local function toggleSwing()
    if closed or not enabled then return end

    if #webs == 0 then
        setStatus("Press E to deploy webs first")
        return
    end

    swinging = not swinging
    launching = false
    retracting = false

    setStatus(swinging and "Web pull ON" or "Web pull OFF")
end

local function retractAll()
    if closed or not enabled then return end

    if #webs == 0 then
        setStatus("No webs to retract")
        return
    end

    launching = false
    swinging = false
    retracting = true

    for _, web in ipairs(webs) do
        web.retracting = true
    end

    setStatus("FAST RETRACT!")
end

