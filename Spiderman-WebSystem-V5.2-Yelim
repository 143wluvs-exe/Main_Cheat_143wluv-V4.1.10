-- GUI BUTTON HELPER
local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -20, 0, 35)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(42, 45, 54)
    button.BorderSizePixel = 0
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Parent = frame

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    button.Activated:Connect(callback)
    return button
end

makeButton("SPIDER LAUNCH | E", 82, spiderLaunch)
makeButton("SWING PULL | F", 123, toggleSwing)
makeButton("FAST RETRACT", 164, retractAll)
makeButton("RELEASE ALL | Q", 205, releaseAll)

toggleButton = makeButton("WEBS: ON", 246, function()
    if closed then return end

    enabled = not enabled
    toggleButton.Text = enabled and "WEBS: ON" or "WEBS: OFF"

    if not enabled then
        releaseAll()
    end

    setStatus(
        enabled and "Web system enabled"
        or "Web system disabled"
    )
end)

-- MINIMIZE / RESTORE
minimizeButton.Activated:Connect(function()
    if closed then return end
    frame.Visible = false
    restoreButton.Visible = true
end)

restoreButton.Activated:Connect(function()
    if closed then return end
    frame.Visible = true
    restoreButton.Visible = false
end)

closeButton.Activated:Connect(shutdown)

-- DRAG SUPPORT
local function makeDraggable(object, dragHandle)
    dragHandle = dragHandle or object

    local dragging = false
    local dragStart
    local startPosition
    local dragInput
    local activeInput

    table.insert(connections, dragHandle.InputBegan:Connect(function(input)
        if closed then return end

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = object.Position
            activeInput = input

            local endedConnection
            endedConnection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    activeInput = nil

                    if endedConnection then
                        endedConnection:Disconnect()
                    end
                end
            end)
        end
    end))

    table.insert(connections, dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    table.insert(connections, UserInputService.InputChanged:Connect(function(input)
        if closed or not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input == dragInput then

            local delta = input.Position - dragStart

            object.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end))
end

-- Drag main GUI by its title bar.
makeDraggable(frame, title)

-- Drag minimized restore button itself.
makeDraggable(restoreButton)

-- MOVEMENT + RETRACTION
local heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
    if closed then return end

    if countLabel and countLabel.Parent then
        countLabel.Text = "Webs: " .. #webs .. " / " .. MAX_WEBS
    end

    local root = getRoot()
    if not root then return end

    if launching then
        launchTime += dt

        if launchTime < LAUNCH_DURATION then
            local forward = root.CFrame.LookVector
            local velocity = root.AssemblyLinearVelocity

            root.AssemblyLinearVelocity = Vector3.new(
                forward.X * LAUNCH_SPEED,
                math.max(velocity.Y, UPWARD_SPEED),
                forward.Z * LAUNCH_SPEED
            )
        else
            launching = false
        end
    end

    for i = #webs, 1, -1 do
        local web = webs[i]

        if not web.anchor or not web.anchor.Parent
            or not web.beam or not web.beam.Parent then
            removeWeb(web)
        elseif swinging and not web.retracting then
            local delta = web.anchor.Position - root.Position

            if delta.Magnitude > 5 then
                root:ApplyImpulse(
                    delta.Unit * root.AssemblyMass
                    * SWING_PULL * dt
                )
            end
        end

        if web and web.retracting
            and web.anchor and web.anchor.Parent then

            local delta = root.Position - web.anchor.Position
            local distance = delta.Magnitude

            if distance <= 2 then
                removeWeb(web)
            elseif distance > 0 then
                web.anchor.Position += delta.Unit
                    * math.min(RETRACT_SPEED * dt, distance)
            end
        end
    end

    if #webs == 0 then
        swinging = false
        retracting = false
    end
end)

table.insert(connections, heartbeatConnection)

-- KEYBOARD CONTROLS
table.insert(connections, UserInputService.InputBegan:Connect(function(input, processed)
    if closed or processed then return end

    if input.KeyCode == Enum.KeyCode.E then
        spiderLaunch()
    elseif input.KeyCode == Enum.KeyCode.F then
        toggleSwing()
    elseif input.KeyCode == Enum.KeyCode.Q then
        releaseAll()
    end
end))

-- RESPAWN SUPPORT
characterConnection = player.CharacterAdded:Connect(function()
    if not closed then
        releaseAll()
    end
end)

-- CLEANUP IF GUI IS DESTROYED EXTERNALLY
gui.Destroying:Connect(function()
    if not closed then
        shutdown()
    end
end)
